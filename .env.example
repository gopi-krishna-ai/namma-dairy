# =================================================================
# Pure Picks / Namma Dairy - Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# =================================================================

# Database
DATABASE_URL="file:./dev.db"

# JWT & Cryptographic Security
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-key-min-32-chars"
OTP_PEPPER_SECRET="replace-with-a-dedicated-otp-hash-pepper-secret-key-min-32-chars"

# Administrator Initial Setup Credentials
INITIAL_ADMIN_EMAIL="admin@purepicks.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-admin-password-min-12-chars"

# =================================================================
# Server-Side Email Service (SMTP)
# Required for sending password-reset OTP verification emails.
# Supported providers: AWS SES, SendGrid, Resend SMTP, Gmail, Postmark
# =================================================================
SMTP_HOST=""          # e.g., smtp.gmail.com / smtp.sendgrid.net / email-smtp.us-east-1.amazonaws.com
SMTP_PORT="587"       # 587 (TLS) or 465 (SSL)
SMTP_USER=""          # SMTP authentication username
SMTP_PASS=""          # SMTP authentication password or App Password
SMTP_SECURE="false"   # "true" for port 465, "false" for port 587
SMTP_FROM="\"Pure Picks Security\" <security@purepicks.com>"

# Store Branding & Details
NEXT_PUBLIC_APP_NAME="Pure Picks"
NEXT_PUBLIC_APP_TAGLINE="Pure Milk • Healthy Life"
NEXT_PUBLIC_LOCATION="Bengaluru, Karnataka"
NEXT_PUBLIC_PHONE="+91 98765 43210"

# Payment Gateway (Optional/Sandbox)
RAZORPAY_KEY_ID="rzp_test_NammaDairy2026"
RAZORPAY_KEY_SECRET="rzp_secret_mock_sandbox_key"
